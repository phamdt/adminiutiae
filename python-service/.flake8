[flake8]
max-line-length = 120
ignore = 
    E203,  # whitespace before ':'
    W503,  # line break before binary operator
    E501,  # line too long (handled by black)
    F401,  # imported but unused (handled by isort)
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .venv,
    venv,
    alembic/versions,
    tests/conftest.py,
per-file-ignores =
    __init__.py:F401
    alembic/env.py:E402
max-complexity = 10